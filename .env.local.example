# Copy to .env.local and fill in. Never commit .env.local.
# Both values below are safe in the browser bundle — RLS is what protects data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys.
# New projects show a publishable key (sb_publishable_...). Older projects show
# an "anon" key instead; if that is all you have, use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Restrict sign-in to your work domain. Comma-separated, no @.
# Leave blank and ANY Google account on the internet can sign up.
ALLOWED_EMAIL_DOMAINS=arbisoft.com

# PostHog analytics. Both are public values that ship in the browser bundle.
# Leave the token blank to disable analytics entirely.
# Host is https://eu.i.posthog.com for projects on EU cloud.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Never put the Supabase service role / secret key in this app. It bypasses RLS,
# and everything here runs where a browser can reach it.
